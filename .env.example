# Copy to .env and fill in ONE provider. Never commit .env.

# --- OpenAI (used when OPENAI_API_KEY is set) ---
# Default model: gpt-4.1-mini (tool calling, no reasoning step).
# If the account rejects that model, set LLM_MODEL=gpt-5-mini or gpt-4o-mini.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini

# --- Gemini via the OpenAI-compatible endpoint ---
# Used when GEMINI_API_KEY is set and OPENAI_API_KEY is empty,
# or when LLM_PROVIDER=gemini.
# GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# If both keys are set, the default provider is OpenAI unless LLM_PROVIDER=gemini.

# Store "today". The CSVs are a snapshot of late March 2026.
# Leave unset to use 2026-03-25. Override to try other policy windows.
# EMPORIO_TODAY=2026-03-25

# Optional alternate data directory.
# EMPORIO_DATA_DIR=./data
